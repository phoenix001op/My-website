{
  "manifest_version": 3,
  "name": "Padh Lo Screen Time Tracker",
  "version": "1.2.1",
  "description": "Counts the time and visits for each website and sends it to your Padh Lo study timer. Data stays on your computer.",
  "permissions": [
    "tabs",
    "storage",
    "idle",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://my-website-ep83.vercel.app/studytimer.html*",
        "https://my-website-ep83.vercel.app/studytimer",
        "https://phoenix001op.github.io/My-website/studytimer.html*",
        "file:///*/studytimer.html*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "youtube.js"
      ],
      "run_at": "document_idle"
    }
  ]
}